# Image build configuration (committed — no secrets)
# Used by: scripts/build.sh, docker-compose.build.yml
# Optional: git mv env.build .env.build if you prefer the dotfile name (make build supports both)

RUNNER_IMAGE=ghcr.io/kostua16/k16-gh-agent-runner:latest

NODE_MAJOR=22
BUN_VERSION=1.3.14
GH_VERSION=2.93.0
GSD_VERSION=1.1.0
RTK_VERSION=0.35.0
# Must match the install script at RTK_VERSION (see amnezia setup-environment action)
RTK_INSTALL_SHA256=9989e60e33a353e9e6802fab1fd410b96d1dd228b34e52402c32f3c8c2dd8c66
PRISMA_VERSION=latest
ACTIONLINT_VERSION=1.7.7
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest

DOCKER_VERSION=28.0.4
DOCKER_COMPOSE_VERSION=2.38.2
YQ_VERSION=4.45.1
SHFMT_VERSION=3.10.0
HADOLINT_VERSION=2.12.0
GITLEAKS_VERSION=8.22.1
UV_VERSION=0.6.14

INSTALL_RTK=true
INSTALL_GSD=true
INSTALL_PRISMA=true
INSTALL_ACTIONLINT=true
INSTALL_CLAUDE_CODE=true
INSTALL_CODEX=true
INSTALL_CURSOR_AGENT=true
