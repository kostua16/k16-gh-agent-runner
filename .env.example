# Production / runtime configuration (docker compose up)
# Quick start: ./install.sh  (or see README Install)
# Manual: copy to .env and set secrets. Build image: make build (uses env.build).

RUNNER_IMAGE=ghcr.io/kostua16/k16-gh-agent-runner:latest

GITHUB_URL=https://github.com/kostua16/k16-gh-agent-runner
RUNNER_TOKEN=
RUNNER_NAME=k16-gh-agent
RUNNER_LABELS=self-hosted,Linux,X64,docker
RUNNER_DISABLE_UPDATE=true
# RUNNER_EPHEMERAL=true
# RUNNER_REMOVE_ON_EXIT=false

# Workflow / agent secrets (optional — do not commit real values)
# Set in GitHub Actions secrets or inject when testing CLIs inside the container.
# ANTHROPIC_API_KEY=
# ZAI_API_KEY=
# OPENAI_API_KEY=
# CURSOR_API_KEY=

# Cursor Agent headless CI example (not used by runner.sh automatically):
# agent -p --force --trust "your prompt"
